<Window x:Class="Clean.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clean" Width="420" Height="300" Background="{StaticResource PaperBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="Enter your name." Foreground="{StaticResource HintBrush}" Background="{StaticResource PaperBrush}"/>
        <Label x:Name="NameLabel" Content="_Name" Target="{Binding ElementName=NameBox}" Foreground="{StaticResource TextBrush}"/>
        <TextBox x:Name="NameBox" AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"
                 Foreground="{StaticResource TextBrush}" Background="{StaticResource PaperBrush}"/>
        <Button Content="Save" Foreground="{StaticResource TextBrush}" Background="{StaticResource PaperBrush}" Click="OnSave"/>
    </StackPanel>
</Window>
